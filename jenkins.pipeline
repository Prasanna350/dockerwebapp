pipeline {
    agent {
        node {
            label 'Manager'
        }
    }
    tools {
        maven 'mymaven'
    }
    stages {
        stage ("Code") {
            steps{
                git 'https://github.com/Prasanna350/dockerwebapp.git'               
            }
        }
        stage ("Build") {
            steps {
                sh 'mvn clean install'
            }
        }
        stage ("CQA") {
            steps {
                withSonarQubeEnv('mysonar') {
                    sh "mvn clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.projectKey=myapp"
                }
            }
        }
        stage ("Quality Gates") {
            steps {
                waitForQualityGate abortPipeline: true, credentialsId: 'sonarqube'
            }
        }
        stage ("Artifact") {
            steps {
                script {
                    def pom = readMavenPom file: 'pom.xml'
                    nexusArtifactUploader artifacts: [[artifactId: pom.artifactId, classifier: '', file: "target/${pom.artifactId}-${pom.version}.war", type: 'war']], credentialsId: 'nexus', groupId: pom.groupId, nexusUrl: '13.211.146.248:8081', nexusVersion: 'nexus3', protocol: 'http', repository: 'myapp', version: pom.version
                }
            }
        }
        stage ("Images") {
            steps {
                sh '''
                    cp -r target Docker-app
                    docker build -t app-image Docker-app
                    docker build -t db-image Docker-db
                '''
            }
        }
        stage ("Image Scan") {
            steps {
                sh '''
                    trivy image app-image
                    trivy image db-image
                '''
            }
        }
        stage ("Registry") {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'dockerhub') {
                        sh '''
                            docker tag app-image pashadeviprasanna943/dockerwebapp-app-image
                            docker tag db-image pashadeviprasanna943/dockerwebapp-db-image
                            docker push pashadeviprasanna943/dockerwebapp-db-image
                            docker push pashadeviprasanna943/dockerwebapp-app-image
                        '''
                    }
                }
            }
        }
        stage ("Deploy") {
            steps {
                sh '''
                    docker stack deploy myapp --compose-file=docker-compose.yml
                '''
            }
        }
    }
}
